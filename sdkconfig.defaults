# =============================================================================
# ESP32-C3 IR Remote Controller — project defaults
# Never edit `sdkconfig` by hand; edit this file and reconfigure instead.
# =============================================================================

# ---- Target -----------------------------------------------------------------
CONFIG_IDF_TARGET="esp32c3"

# ---- Flash ------------------------------------------------------------------
# Measured 2026-10-02 with `esptool flash_id`: 4 MB (XMC). For a 2 MB part use
# CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y together with partitions_2mb.csv.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y

# ---- Partition table --------------------------------------------------------
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- Radio: BLE (NimBLE) only, no Wi-Fi -------------------------------------
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=512
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=4096
# NOTE: Wi-Fi cannot be switched off with a config option — `ESP_WIFI_ENABLED`
# has no prompt. It enters the build graph only as a transitive dependency of
# `esp_phy`, and all of its code is dropped by the linker because nothing
# references it (verify: no `esp_wifi_*` symbols in build/*.map).

# ---- Size and diagnostics ---------------------------------------------------
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Development log level: INFO keeps bring-up traces visible. Shipping firmware
# must lower this to WARN (done in the M9 hardening milestone) to keep the UART
# quiet and protect IR timing.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_MAXIMUM_LEVEL_INFO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# ---- RMT / IR --------------------------------------------------------------
# ISR-safe placement for the IR record/playback hot paths.
CONFIG_RMT_TX_ISR_HANDLER_IN_IRAM=y
CONFIG_RMT_RX_ISR_HANDLER_IN_IRAM=y
